# Copy this file to ".env" if you want to change anything. Every setting is optional.
# No API key and no internet are needed: all the AI runs on your own computer.

# TUTOR_LANGUAGE=English          # language of drafted messages: English, Hinglish or Hindi
# DWELL_SECONDS=2.0               # how long the mouse must stay still before auto-explain
# TUTOR_HOTKEY=<ctrl>+<shift>+h
# SENSITIVE_WORDS=password,bank,login,sign in,otp,wallet,payment,upi
# USE_UIA=1                       # Windows only: read the exact button name under the cursor
# USE_OCR=1                       # read text near the cursor with the OCR neural network
# (the agent's thresholds and trust weights are tuned by `python tune.py`, not set here)
